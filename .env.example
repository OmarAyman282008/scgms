# Copy to .env and edit before the first start.  NEVER commit the real .env.

# --- required ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-db-password
# the address(es) people will type in the browser
DJANGO_ALLOWED_HOSTS=committees.badyauniversity.edu.eg,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://committees.badyauniversity.edu.eg
SITE_URL=https://committees.badyauniversity.edu.eg

# --- options ---
DJANGO_DEBUG=0
# set to 1 once the site is served over HTTPS
DJANGO_SECURE_COOKIES=0
# 1 = load the DEMO sample meetings/decisions/tasks on the first start (remove later with: purge_demo)
LOAD_DEMO_DATA=0
TIME_ZONE=Africa/Cairo
MAX_UPLOAD_MB=25
# hour of the day (0-23) when daily reminders are sent
REMINDER_HOUR=7
HTTP_PORT=80

# --- e-mail (optional; then switch e-mail on in Administration → Settings) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=committees@badyauniversity.edu.eg
